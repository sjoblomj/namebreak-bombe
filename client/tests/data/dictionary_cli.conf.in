# GENERATED by CMakeLists.txt from tests/data/dictionary_cli.conf.in, for the
# dictionary-cli tests: REZ\CRDT_LST.TXT, by its real hashes and encryption
# key, from a few words.
mode = @DICTIONARY_CLI_MODE@
matches_dir = matches
check_for_updates = false

[dictionary]
builtin_dictionary = none
dictionaries = @DICTIONARY_CLI_WORDS@
@DICTIONARY_CLI_MAX_WORDS@
separators = "", "_"
prefix = rez\
suffix = .txt
hash_a = 0x339EFE07
hash_b = @DICTIONARY_CLI_HASH_B@
encryption_key = 0x4565C467
matches_name = credits
