{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "CUDA",
      "description": "The program as it ships: the CUDA backend, with coordinator mode",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NAMEBREAK_GPU": "cuda"
      }
    },
    {
      "name": "portable",
      "displayName": "Portable",
      "description": "No CUDA: only the CPU backends",
      "binaryDir": "${sourceDir}/build-portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NAMEBREAK_GPU": "none"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 0
    },
    {
      "name": "portable",
      "configurePreset": "portable",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "portable",
      "configurePreset": "portable",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    }
  ]
}
